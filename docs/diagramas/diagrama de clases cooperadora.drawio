        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n  class Cooperadora {\n    +int id\n    +String nombre\n    +String cuit\n    +String direccion\n    +registrarSocio()\n    +registrarPago()\n    +emitirReporte()\n  }\n\n  class Socio {\n    +int id\n    +String nombre\n    +String apellido\n    +String documento\n    +String email\n    +String telefono\n    +Date fechaAlta\n    +String estado\n    +actualizarDatos()\n    +consultarEstadoCuenta()\n  }\n\n  class Alumno {\n    +int id\n    +String nombre\n    +String apellido\n    +String documento\n    +String curso\n    +String turno\n  }\n\n  class Cuota {\n    +int id\n    +String concepto\n    +Decimal importe\n    +Date vencimiento\n    +String periodo\n    +String estado\n    +calcularRecargo()\n  }\n\n  class Pago {\n    +int id\n    +Date fecha\n    +Decimal importe\n    +String estado\n    +String observaciones\n    +registrar()\n    +anular()\n    +generarComprobante()\n  }\n\n  class MedioPago {\n    &lt;&lt;enumeration&gt;&gt;\n    EFECTIVO\n    TRANSFERENCIA\n    TARJETA\n    MERCADO_PAGO\n  }\n\n  class Comprobante {\n    +int numero\n    +Date fechaEmision\n    +Decimal importe\n    +String tipo\n    +generarPDF()\n  }\n\n  class Usuario {\n    +int id\n    +String nombre\n    +String email\n    +String rol\n    +iniciarSesion()\n    +registrarPago()\n  }\n\n  class Tesoreria {\n    +int id\n    +Date periodo\n    +Decimal saldoInicial\n    +Decimal ingresos\n    +Decimal egresos\n    +calcularSaldo()\n    +cerrarPeriodo()\n  }\n\n  Cooperadora \&quot;1\&quot; o-- \&quot;0..*\&quot; Socio : administra\n  Socio \&quot;1\&quot; -- \&quot;0..*\&quot; Alumno : representa\n  Socio \&quot;1\&quot; -- \&quot;0..*\&quot; Cuota : debe\n  Cuota \&quot;1\&quot; -- \&quot;0..*\&quot; Pago : recibe\n  Pago \&quot;1\&quot; --&gt; \&quot;1\&quot; MedioPago : utiliza\n  Pago \&quot;1\&quot; *-- \&quot;1\&quot; Comprobante : genera\n  Usuario \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Pago : registra\n  Cooperadora \&quot;1\&quot; *-- \&quot;1\&quot; Tesoreria : gestiona\n  Tesoreria \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Pago : consolida&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="q9MAVjyjl62DhCbJ9Aif-1">
