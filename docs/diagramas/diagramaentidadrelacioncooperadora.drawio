        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam linetype ortho\n\nentity \&quot;Cooperadora\&quot; as COOPERADORA {\n  * id : int &lt;&lt;PK&gt;&gt;\n  --\n  nombre : string\n  cuit : string\n  direccion : string\n}\n\nentity \&quot;Tesoreria\&quot; as TESORERIA {\n  * id : int &lt;&lt;PK&gt;&gt;\n  --\n  cooperadora_id : int &lt;&lt;FK&gt;&gt;\n  periodo : date\n  saldoInicial : decimal\n  ingresos : decimal\n  egresos : decimal\n}\n\nentity \&quot;Socio\&quot; as SOCIO {\n  * id : int &lt;&lt;PK&gt;&gt;\n  --\n  cooperadora_id : int &lt;&lt;FK&gt;&gt;\n  nombre : string\n  apellido : string\n  documento : string\n  email : string\n  telefono : string\n  fechaAlta : date\n  estado : string\n}\n\nentity \&quot;Alumno\&quot; as ALUMNO {\n  * id : int &lt;&lt;PK&gt;&gt;\n  --\n  socio_id : int &lt;&lt;FK&gt;&gt;\n  nombre : string\n  apellido : string\n  documento : string\n  curso : string\n  turno : string\n}\n\nentity \&quot;Cuota\&quot; as CUOTA {\n  * id : int &lt;&lt;PK&gt;&gt;\n  --\n  socio_id : int &lt;&lt;FK&gt;&gt;\n  concepto : string\n  importe : decimal\n  vencimiento : date\n  periodo : string\n  estado : string\n}\n\nentity \&quot;Usuario\&quot; as USUARIO {\n  * id : int &lt;&lt;PK&gt;&gt;\n  --\n  nombre : string\n  email : string\n  rol : string\n}\n\nentity \&quot;Pago\&quot; as PAGO {\n  * id : int &lt;&lt;PK&gt;&gt;\n  --\n  cuota_id : int &lt;&lt;FK&gt;&gt;\n  usuario_id : int &lt;&lt;FK&gt;&gt;\n  tesoreria_id : int &lt;&lt;FK&gt;&gt;\n  fecha : date\n  importe : decimal\n  estado : string\n  observaciones : string\n  medioPago : string\n}\n\nentity \&quot;Comprobante\&quot; as COMPROBANTE {\n  * numero : int &lt;&lt;PK&gt;&gt;\n  --\n  pago_id : int &lt;&lt;FK&gt;&gt;\n  fechaEmision : date\n  importe : decimal\n  tipo : string\n}\n\nCOOPERADORA ||--|| TESORERIA : gestiona\nCOOPERADORA ||--o{ SOCIO : administra\nSOCIO ||--o{ ALUMNO : representa\nSOCIO ||--o{ CUOTA : genera\nCUOTA ||--o{ PAGO : liquida\nUSUARIO ||--o{ PAGO : registra\nTESORERIA ||--o{ PAGO : consolida\nPAGO ||--|| COMPROBANTE : genera\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="PJW9zHcys1kvukBdoNmR-1">
